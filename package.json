{
  "name": "clinic-manager",
  "version": "1.0.0",
  "description": "Optical clinic management desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "35.0.0",
    "electron-builder": "25.1.0"
  },
  "build": {
    "appId": "com.clinic-manager.app",
    "productName": "Clinic Manager",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "dist/clinic-backend.exe",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": null
    }
  }
}
